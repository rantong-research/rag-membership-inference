# 复制本文件为 .env，并填入你自己的配置。
# 说明：.env 已被 .gitignore 忽略，不会提交到 Git。

# 当 src/config.py 中的 api_key / base_url 为空时，才会读取以下环境变量。

# 云端 OpenAI 兼容接口示例（阿里云百炼 / DashScope / OpenAI 等）：
api_key=YOUR_API_KEY
base_url=YOUR_OPENAI_COMPATIBLE_BASE_URL

# 如果使用本地部署模型：
# 默认 src/config.py 已指向 http://localhost:6006/v1 且 api_key="EMPTY"，
# 通常无需配置 .env，直接在 src/config.py 里修改 chat_model / base_url 即可。
